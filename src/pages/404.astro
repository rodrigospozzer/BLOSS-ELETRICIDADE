---
import Base from '../layouts/Base.astro';
---

<Base title="Página não encontrada">
  <section class="min-h-[70vh] flex flex-col items-center justify-center text-center px-4 py-24 bg-brand-light">
    <h1 class="text-6xl md:text-8xl font-serif font-bold text-brand-dark mb-4">404</h1>
    <h2 class="text-2xl md:text-3xl font-bold mb-8">Página não encontrada</h2>
    <p class="text-lg text-neutral-600 mb-8 max-w-md mx-auto">
      A página que você está procurando pode ter sido removida, mudado de nome ou está temporariamente indisponível.
    </p>
    <a href="/" class="bg-brand-dark text-brand-light px-8 py-4 rounded-full font-bold hover:bg-neutral-800 transition-colors">
      Voltar para o Início
    </a>
  </section>
</Base>

<section class="relative h-[100svh] overflow-hidden bg-brand-dark flex items-center justify-center">
  <div class="absolute inset-0 w-full h-[115%] top-0">
    <img 
      src="https://images.unsplash.com/photo-1600585154340-be6161a56a0c?q=80&w=2070&auto=format&fit=crop" 
      alt="Hero Background" 
      class="w-full h-full object-cover object-center"
      data-hero-parallax
    />
    <div class="absolute inset-0 bg-black/40"></div>
  </div>

  <div class="relative z-10 container mx-auto px-4 text-center text-brand-light">
    <h1 class="font-serif font-bold mb-6 max-w-4xl mx-auto text-[clamp(2.5rem,8vw,5rem)] leading-tight" data-split-text>
      Design Premium para o seu Negócio
    </h1>
    <p class="text-lg md:text-xl max-w-2xl mx-auto mb-8 opacity-90" data-reveal>

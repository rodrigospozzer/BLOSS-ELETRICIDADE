---
// Authority.astro
const authImage = '/src/assets/originals/imgi_8_669658421_18088477829600356_2168918359444439195_n.webp';
---

<section id="autoridade" class="lg:hidden bg-brand-surface py-16" aria-label="Nossa Estrutura">
  <div class="container mx-auto px-5">
    <div class="mb-8" data-reveal>
      <h2 class="text-[32px] font-extrabold text-brand-black leading-tight mb-4">
        Estrutura para<br/>
        <span class="text-brand-orange">Grandes Obras</span>
      </h2>
      <p class="text-[16px] text-brand-text-muted leading-relaxed">
        Capacidade técnica e operacional para atender desde residências até complexos prediais e comerciais com total segurança.
      </p>
    </div>

    <div class="w-full aspect-[4/3] overflow-hidden bg-brand-black rounded-[8px]" data-reveal>
      <img 
        src={authImage} 
        alt="Edificação com frota da Bloss Eletricidade em frente." 
        class="w-full h-full object-cover object-[50%_82%]"
        loading="lazy"
      />
    </div>
  </div>
</section>

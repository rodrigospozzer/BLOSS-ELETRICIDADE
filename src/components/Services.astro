---
import { siteConfig } from '../config/site';
import { Image } from 'astro:assets';

const services = siteConfig.services.items;
---

<section id="servicos" class="py-16 lg:py-24 bg-brand-surface">
  <div class="container mx-auto px-5 lg:px-18">
    <div class="mb-12 lg:mb-16 max-w-2xl" data-reveal>
      <h2 class="text-[32px] lg:text-[46px] font-extrabold text-brand-black leading-tight mb-4">
        <span class="lg:hidden" set:html={siteConfig.services.headlineMobile}></span>
        <span class="hidden lg:inline">{siteConfig.services.headlinePrefix} <span class="text-brand-orange">{siteConfig.services.headlineHighlight}</span></span>
      </h2>
      <p class="text-[16px] lg:text-[18px] text-brand-text-muted leading-relaxed hidden lg:block">
        {siteConfig.services.supporting}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-8">
      {services.map((service, index) => (
        <div class="group bg-brand-offwhite rounded-[8px] overflow-hidden border border-brand-border/40 hover:border-brand-orange transition-colors duration-300" data-reveal>
          <div class="w-full aspect-[1.6/1] lg:aspect-[1.3/1] overflow-hidden bg-brand-black">
            <Image 
              src={service.image} 
              alt={service.alt} 
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
              style={`object-position: ${service.deskCrop};`}
              width={400}
              format="webp"
            />
          </div>
          <div class="p-6 lg:p-8">
            <h3 class="text-[20px] font-bold text-brand-black mb-3">{service.title}</h3>
            <p class="text-[15px] text-brand-text-muted leading-relaxed mb-6">{service.desc}</p>
            <a href={`https://wa.me/${siteConfig.whatsapp}?text=${encodeURIComponent(siteConfig.whatsappMessage)}`} target="_blank" class="inline-flex items-center text-brand-black font-bold text-[14px] uppercase tracking-wider group-hover:text-brand-orange transition-colors">
              {siteConfig.services.cta}
              <svg xmlns="http://www.w3.org/2000/svg" class="ml-2 w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* Use media queries to override inline styles if possible, but inline style works fine.
     We will apply a custom class to handle the mobile crop dynamically. */
</style>

---
import { siteConfig } from '../config/site';

const reviews = siteConfig.reviews.items;
---

<section id="avaliacoes" class="py-16 lg:py-32 bg-brand-black text-brand-surface overflow-hidden">
  <div class="container mx-auto px-5 lg:px-18">
    <div class="flex flex-col lg:flex-row items-center gap-12 lg:gap-24">
      
      <!-- Headline (Left) -->
      <div class="w-full lg:w-1/3" data-reveal>
        <h2 class="text-[32px] lg:text-[46px] font-extrabold leading-tight mb-6 lg:mb-8">
          {siteConfig.reviews.headlinePrefix} <span class="text-brand-yellow">{siteConfig.reviews.headlineHighlight}</span>
        </h2>
        <p class="text-[16px] lg:text-[18px] text-brand-offwhite/80 leading-relaxed mb-8">
          {siteConfig.reviews.supporting}
        </p>
        <div class="hidden lg:flex gap-4">
          <button id="prev-btn" aria-label="Avaliação anterior" class="w-12 h-12 rounded-full border border-brand-border/30 flex items-center justify-center hover:bg-brand-surface hover:text-brand-black transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
          </button>
          <button id="next-btn" aria-label="Próxima avaliação" class="w-12 h-12 rounded-full border border-brand-border/30 flex items-center justify-center hover:bg-brand-surface hover:text-brand-black transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
          </button>
        </div>
      </div>

      <!-- Carousel Container (Right) -->
      <div class="w-full lg:w-2/3" data-reveal>
        <div 
          class="flex overflow-x-auto snap-x snap-mandatory gap-6 pb-4 hide-scrollbar" 
          id="reviews-track"
          aria-label="Avaliações de clientes" 
          role="region"
        >
          {reviews.map((review, index) => (
            <div class="min-w-full snap-center bg-[#1A1A1A] p-8 lg:p-14 rounded-[8px] flex flex-col justify-between border border-brand-border/10" role="group" aria-roledescription="slide">
              <div>
                <div class="flex gap-1 text-brand-yellow mb-6">
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                </div>
                <p class="text-[18px] lg:text-[24px] font-medium leading-relaxed italic mb-10">
                  "{review.text}"
                </p>
              </div>
              <div class="flex items-center gap-4">
                <div class="w-14 h-14 rounded-full bg-brand-surface text-brand-black flex items-center justify-center font-bold text-[20px]">
                  {review.initial}
                </div>
                <div>
                  <div class="font-bold text-[18px]">{review.name}</div>
                  <div class="text-[15px] text-brand-offwhite/60">Avaliação Real no Google</div>
                </div>
              </div>
            </div>
          ))}
        </div>
        
        <!-- Mobile Controls -->
        <div class="flex lg:hidden gap-4 mt-6 justify-center">
          <button id="prev-btn-mob" aria-label="Avaliação anterior" class="w-12 h-12 rounded-full border border-brand-border/30 flex items-center justify-center hover:bg-brand-surface hover:text-brand-black transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
          </button>
          <button id="next-btn-mob" aria-label="Próxima avaliação" class="w-12 h-12 rounded-full border border-brand-border/30 flex items-center justify-center hover:bg-brand-surface hover:text-brand-black transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
          </button>
        </div>

      </div>

    </div>
  </div>
</section>

<script>
  // Simple scroll control
  const track = document.getElementById('reviews-track');
  const btnsPrev = [document.getElementById('prev-btn'), document.getElementById('prev-btn-mob')];
  const btnsNext = [document.getElementById('next-btn'), document.getElementById('next-btn-mob')];

  if (track) {
    const scrollAmount = () => track.clientWidth;

    btnsPrev.forEach(btn => {
      if (btn) {
        btn.addEventListener('click', () => {
          track.scrollBy({ left: -scrollAmount(), behavior: 'smooth' });
        });
      }
    });

    btnsNext.forEach(btn => {
      if (btn) {
        btn.addEventListener('click', () => {
          track.scrollBy({ left: scrollAmount(), behavior: 'smooth' });
        });
      }
    });
  }
</script>

<style>
  .hide-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .hide-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>

---
import { siteConfig } from '../config/site';
import MobileMenu from './MobileMenu.astro';
---

<header id="main-header" class="fixed top-0 left-0 w-full z-40 transition-colors duration-300 bg-transparent">
  <div class="container mx-auto px-4 h-20 flex items-center justify-between">
    <a href="/" class="text-2xl font-serif font-bold text-brand-light z-50 transition-colors duration-300" id="header-logo">
      {siteConfig.name}
    </a>
    
    <nav aria-label="Navegação principal" class="hidden md:flex space-x-8 text-brand-light" id="header-nav">
      <a href="#sobre" class="hover:text-brand-accent transition-colors">Sobre</a>
      <a href="#servicos" class="hover:text-brand-accent transition-colors">Serviços</a>
      <a href="#contato" class="hover:text-brand-accent transition-colors">Contato</a>
    </nav>

    <button id="menu-toggle" aria-expanded="false" aria-label="Abrir menu" class="md:hidden z-50 flex flex-col justify-center items-center w-10 h-10 space-y-1.5">
      <span class="w-6 h-0.5 bg-brand-light transition-all duration-300"></span>
      <span class="w-6 h-0.5 bg-brand-light transition-all duration-300"></span>
    </button>
  </div>
</header>

<MobileMenu />

<script>
  const header = document.getElementById('main-header');
  const logo = document.getElementById('header-logo');
  const nav = document.getElementById('header-nav');
  const menuToggle = document.getElementById('menu-toggle');
  const lines = menuToggle?.querySelectorAll('span');

  const updateHeader = () => {
    if (!header || !logo || !nav || !lines) return;
    const isScrolled = window.scrollY > 10;
    
    if (isScrolled) {
      header.classList.remove('bg-transparent');
      header.classList.add('bg-brand-light', 'shadow-md'); // Using white bg as example
      logo.classList.remove('text-brand-light');
      logo.classList.add('text-brand-dark');
      nav.classList.remove('text-brand-light');
      nav.classList.add('text-brand-dark');
      lines.forEach(l => {
        l.classList.remove('bg-brand-light');
        l.classList.add('bg-brand-dark');
      });
    } else {
      header.classList.add('bg-transparent');
      header.classList.remove('bg-brand-light', 'shadow-md');
      logo.classList.add('text-brand-light');
      logo.classList.remove('text-brand-dark');
      nav.classList.add('text-brand-light');
      nav.classList.remove('text-brand-dark');
      lines.forEach(l => {
        l.classList.add('bg-brand-light');
        l.classList.remove('bg-brand-dark');
      });
    }
  };

  window.addEventListener('scroll', updateHeader);
  window.addEventListener('load', updateHeader);
</script>

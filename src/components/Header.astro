---
import { siteConfig } from '../config/site';

const navItems = [
  { label: 'Início', href: '#inicio' },
  { label: 'Serviços', href: '#servicos' },
  { label: 'Projetos', href: '#projetos' },
  { label: 'Sobre', href: '#autoridade' },
  { label: 'Avaliações', href: '#avaliacoes' },
  { label: 'Contato', href: '#contato' },
];
---

<header class="fixed top-0 left-0 w-full z-50 transition-colors duration-300" id="main-header">
  <!-- Desktop Header -->
  <div class="hidden lg:flex container mx-auto px-14 lg:px-18 items-center h-20">
    <a href="#inicio" class="flex-shrink-0" aria-label="Página Inicial">
      <img src="/src/assets/brand/bloss-logo.png" alt="Bloss Eletricidade Logo" class="h-10 w-auto" id="desktop-logo" />
    </a>
    
    <nav class="flex-1 flex justify-end items-center gap-9" aria-label="Navegação Principal">
      <ul class="flex gap-9 text-[14px] font-semibold uppercase tracking-wider text-brand-surface" id="desktop-nav-links">
        {navItems.map(item => (
          <li><a href={item.href} class="hover:text-brand-yellow transition-colors">{item.label}</a></li>
        ))}
      </ul>
      <a 
        href={`https://wa.me/${siteConfig.whatsapp}?text=${encodeURIComponent(siteConfig.whatsappMessage)}`}
        target="_blank" rel="noopener noreferrer"
        class="bg-brand-yellow text-brand-black px-6 h-12 flex items-center justify-center font-bold text-[14px] uppercase tracking-wider rounded-[6px] hover:bg-white transition-colors"
      >
        Solicitar Orçamento
      </a>
    </nav>
  </div>

  <!-- Mobile Header -->
  <div class="lg:hidden flex items-center justify-between px-5 h-[80px] w-full" id="mobile-header-bar">
    <a href="#inicio" class="flex-shrink-0 relative" aria-label="Página Inicial">
      <img src="/src/assets/brand/bloss-logo.png" alt="Bloss Eletricidade Logo" class="h-8 w-auto" />
    </a>
    
    <div class="flex items-center gap-3 relative">
      <a 
        href={`https://wa.me/${siteConfig.whatsapp}?text=${encodeURIComponent(siteConfig.whatsappMessage)}`}
        target="_blank" rel="noopener noreferrer"
        aria-label="Falar no WhatsApp"
        class="w-12 h-12 bg-brand-yellow flex items-center justify-center rounded-[6px]"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-brand-black">
          <path d="M3 21l1.65-3.8a9 9 0 1 1 3.4 2.9L3 21" />
          <path d="M9 10a.5.5 0 0 0 1 0V9a.5.5 0 0 0-1 0v1Z" />
          <path d="M14 10a.5.5 0 0 0 1 0V9a.5.5 0 0 0-1 0v1Z" />
          <path d="M9 15a.5.5 0 0 0 1 0v-1a.5.5 0 0 0-1 0v1Z" />
          <path d="M14 15a.5.5 0 0 0 1 0v-1a.5.5 0 0 0-1 0v1Z" />
        </svg>
      </a>
      
      <button 
        id="menu-toggle" 
        class="w-12 h-12 flex items-center justify-center text-brand-surface relative z-50"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Abrir menu"
      >
        <!-- Hamburger Icon -->
        <svg id="icon-menu" xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="absolute inset-auto transition-opacity duration-300 opacity-100">
          <line x1="4" x2="20" y1="12" y2="12" />
          <line x1="4" x2="20" y1="6" y2="6" />
          <line x1="4" x2="20" y1="18" y2="18" />
        </svg>
        <!-- Close Icon -->
        <svg id="icon-close" xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="absolute inset-auto transition-opacity duration-300 opacity-0 pointer-events-none">
          <line x1="18" y1="6" x2="6" y2="18" />
          <line x1="6" y1="6" x2="18" y2="18" />
        </svg>
      </button>
    </div>
  </div>
</header>

<!-- Mobile Menu Overlay -->
<div id="mobile-menu" class="fixed inset-0 top-[80px] bg-brand-black z-40 flex-col justify-center items-center h-[calc(100dvh-80px)] opacity-0 pointer-events-none transition-opacity duration-300" role="dialog" aria-modal="true" aria-label="Menu principal">
  <!-- Click outside catcher -->
  <div id="mobile-menu-bg" class="absolute inset-0 z-0"></div>
  <nav class="relative z-10 flex flex-col items-center gap-8 text-2xl font-bold text-brand-surface uppercase tracking-tight">
    {navItems.map(item => (
      <a href={item.href} class="mobile-link hover:text-brand-yellow transition-colors flex items-center justify-center min-h-[48px] px-8">{item.label}</a>
    ))}
  </nav>
</div>

<script>
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { gsap } from 'gsap';

  gsap.registerPlugin(ScrollTrigger);

  // --- MOBILE MENU LOGIC ---
  const menuToggle = document.getElementById('menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const mobileMenuBg = document.getElementById('mobile-menu-bg');
  const mobileLinks = document.querySelectorAll('.mobile-link');
  const iconMenu = document.getElementById('icon-menu');
  const iconClose = document.getElementById('icon-close');
  
  let isMenuOpen = false;

  function closeMenu() {
    if (!isMenuOpen) return;
    isMenuOpen = false;
    
    // ARIA
    menuToggle?.setAttribute('aria-expanded', 'false');
    menuToggle?.setAttribute('aria-label', 'Abrir menu');
    
    // Toggle Icons
    if (iconMenu && iconClose) {
      iconMenu.classList.remove('opacity-0');
      iconMenu.classList.add('opacity-100');
      iconClose.classList.remove('opacity-100');
      iconClose.classList.add('opacity-0');
    }
    
    // Hide overlay
    if (mobileMenu) {
      mobileMenu.classList.remove('pointer-events-auto');
      mobileMenu.classList.add('pointer-events-none');
      mobileMenu.classList.remove('opacity-100');
      mobileMenu.classList.add('opacity-0');
      // Set display none after transition
      setTimeout(() => {
        if (!isMenuOpen) mobileMenu.style.display = 'none';
      }, 300);
    }
    
    // Restore Body Scroll
    document.documentElement.classList.remove('overflow-hidden');
    // @ts-ignore
    if (window.lenis) window.lenis.start();

    // Update header background based on scroll
    updateHeader();
  }

  function openMenu() {
    if (isMenuOpen) return;
    isMenuOpen = true;
    
    // ARIA
    menuToggle?.setAttribute('aria-expanded', 'true');
    menuToggle?.setAttribute('aria-label', 'Fechar menu');
    
    // Toggle Icons
    if (iconMenu && iconClose) {
      iconMenu.classList.remove('opacity-100');
      iconMenu.classList.add('opacity-0');
      iconClose.classList.remove('opacity-0');
      iconClose.classList.add('opacity-100');
    }
    
    // Show overlay
    if (mobileMenu) {
      mobileMenu.style.display = 'flex';
      // Small delay to allow display:flex to apply before transition
      requestAnimationFrame(() => {
        mobileMenu.classList.remove('pointer-events-none');
        mobileMenu.classList.add('pointer-events-auto');
        mobileMenu.classList.remove('opacity-0');
        mobileMenu.classList.add('opacity-100');
      });
    }
    
    // Block Body Scroll
    document.documentElement.classList.add('overflow-hidden');
    // @ts-ignore
    if (window.lenis) window.lenis.stop();

    // Force header background when menu is open
    header?.classList.add('bg-brand-black');
  }

  function toggleMenu() {
    if (isMenuOpen) {
      closeMenu();
    } else {
      openMenu();
    }
  }

  // Event Listeners
  menuToggle?.addEventListener('click', toggleMenu);
  
  mobileMenuBg?.addEventListener('click', closeMenu);

  mobileLinks.forEach(link => {
    link.addEventListener('click', () => {
      closeMenu();
    });
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isMenuOpen) {
      closeMenu();
    }
  });


  // --- HEADER SCROLL LOGIC (DESKTOP) ---
  const header = document.getElementById('main-header');

  function updateHeader() {
    if (window.scrollY > 10 || isMenuOpen) {
      header?.classList.add('bg-brand-black');
    } else {
      header?.classList.remove('bg-brand-black');
    }
  }

  window.addEventListener('scroll', updateHeader, { passive: true });
  window.addEventListener('resize', updateHeader, { passive: true });
  updateHeader(); // Run on load
</script>

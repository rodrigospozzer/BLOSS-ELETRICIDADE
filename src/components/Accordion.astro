---
// Accordion.astro
import { siteConfig } from '../config/site';

const faq = siteConfig.faq.items;
---

<section class="py-16 lg:py-24 bg-brand-surface" aria-label="Perguntas Frequentes">
  <div class="container mx-auto px-5 lg:px-18">
    <div class="flex flex-col lg:flex-row gap-12 lg:gap-16" data-reveal>
      
      <!-- Headline and CTA (Left) -->
      <div class="w-full lg:w-1/3">
        <h2 class="text-[32px] lg:text-[46px] font-extrabold text-brand-black leading-tight mb-6">
          {siteConfig.faq.headlinePrefix} <span class="text-brand-yellow">{siteConfig.faq.headlineHighlight}</span>
        </h2>
        <p class="text-[16px] lg:text-[18px] text-brand-text-muted leading-relaxed mb-8">
          {siteConfig.faq.supporting}
        </p>
        <a 
          href={`https://wa.me/${siteConfig.whatsapp}?text=${encodeURIComponent(siteConfig.whatsappMessage)}`}
          target="_blank" rel="noopener noreferrer"
          class="bg-brand-yellow text-brand-black px-8 h-[52px] inline-flex items-center justify-center font-bold text-[15px] uppercase tracking-wider rounded-[7px] hover:bg-brand-black hover:text-brand-yellow transition-colors"
        >
          {siteConfig.faq.cta}
        </a>
      </div>

      <!-- FAQ Items (Right) -->
      <div class="w-full lg:w-2/3">
        <div class="columns-1 md:columns-2 gap-4 lg:gap-6" id="faq-accordion">
          {faq.map((item, index) => (
            <div class="border border-brand-border/40 rounded-[8px] bg-brand-offwhite overflow-hidden mb-4 break-inside-avoid">
              <button 
                class="w-full text-left px-5 py-5 lg:px-6 lg:py-5 flex justify-between items-center focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-yellow"
                aria-expanded="false"
                aria-controls={`faq-answer-${index}`}
                id={`faq-question-${index}`}
              >
                <span class="font-bold text-[15px] lg:text-[16px] text-brand-black pr-4">{item.question}</span>
                <svg class="w-5 h-5 text-brand-yellow transform transition-transform duration-300 icon-plus flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
                </svg>
              </button>
              <div 
                id={`faq-answer-${index}`} 
                role="region" 
                aria-labelledby={`faq-question-${index}`}
                class="hidden px-5 pb-5 lg:px-6 lg:pb-5 text-brand-text-muted text-[14px] lg:text-[15px] leading-relaxed"
              >
                {item.answer}
              </div>
            </div>
          ))}
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';

  const accordionContainer = document.getElementById('faq-accordion');
  if (accordionContainer) {
    const buttons = accordionContainer.querySelectorAll('button');
    
    buttons.forEach(button => {
      button.addEventListener('click', () => {
        const expanded = button.getAttribute('aria-expanded') === 'true';
        const contentId = button.getAttribute('aria-controls');
        const content = document.getElementById(contentId || '');
        const icon = button.querySelector('.icon-plus');
        
        // Close all others
        buttons.forEach(otherBtn => {
          if (otherBtn !== button) {
            otherBtn.setAttribute('aria-expanded', 'false');
            const otherContent = document.getElementById(otherBtn.getAttribute('aria-controls') || '');
            const otherIcon = otherBtn.querySelector('.icon-plus');
            if (otherContent && !otherContent.classList.contains('hidden')) {
              gsap.to(otherContent, {
                height: 0,
                opacity: 0,
                duration: 0.3,
                onComplete: () => {
                  otherContent.classList.add('hidden');
                  otherContent.style.height = 'auto';
                }
              });
              gsap.to(otherIcon, { rotation: 0, duration: 0.3 });
            }
          }
        });

        // Toggle current
        if (expanded) {
          button.setAttribute('aria-expanded', 'false');
          if (content) {
            gsap.to(content, {
              height: 0,
              opacity: 0,
              duration: 0.3,
              onComplete: () => {
                content.classList.add('hidden');
                content.style.height = 'auto';
              }
            });
          }
          if (icon) gsap.to(icon, { rotation: 0, duration: 0.3 });
        } else {
          button.setAttribute('aria-expanded', 'true');
          if (content) {
            content.classList.remove('hidden');
            gsap.fromTo(content, 
              { height: 0, opacity: 0 },
              { height: 'auto', opacity: 1, duration: 0.3 }
            );
          }
          // Rotate to an 'X'
          if (icon) gsap.to(icon, { rotation: 45, duration: 0.3 });
        }
      });
    });
  }
</script>

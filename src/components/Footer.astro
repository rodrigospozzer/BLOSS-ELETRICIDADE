---
// Footer.astro
import { siteConfig } from '../config/site';
import logo from '../assets/brand/bloss-logo.png';
const year = new Date().getFullYear();
---

<footer class="bg-brand-black pt-16 lg:pt-20 pb-8 border-t border-brand-border/20">
  <div class="container mx-auto px-5 lg:px-18">
    <div class="flex flex-col lg:flex-row justify-between items-start gap-12 lg:gap-8 mb-16">
      
      <!-- Brand & About -->
      <div class="w-full lg:w-1/3">
        <a href="#inicio" aria-label="Página Inicial" class="inline-block mb-6">
          <img src={logo.src} alt="Bloss Eletricidade" class="h-10 w-auto" />
        </a>
        <p class="text-[15px] text-brand-offwhite/60 leading-relaxed max-w-sm">
          {siteConfig.footer.description}
        </p>
      </div>

      <!-- Links -->
      <div class="w-full lg:w-1/3 flex flex-col lg:items-center">
        <div>
          <h4 class="text-[14px] font-bold uppercase tracking-wider text-brand-surface mb-6">Navegação</h4>
          <ul class="space-y-3 text-[15px] text-brand-offwhite/70">
            <li><a href="#servicos" class="hover:text-brand-yellow transition-colors">Serviços</a></li>
            <li><a href="#projetos" class="hover:text-brand-yellow transition-colors">Obras</a></li>
            <li><a href="#avaliacoes" class="hover:text-brand-yellow transition-colors">Avaliações</a></li>
            <li><a href="#contato" class="hover:text-brand-yellow transition-colors">Contato</a></li>
          </ul>
        </div>
      </div>

      <!-- Contact -->
      <div class="w-full lg:w-1/3 flex flex-col lg:items-end">
        <div>
          <h4 class="text-[14px] font-bold uppercase tracking-wider text-brand-surface mb-6">Fale Conosco</h4>
          <ul class="space-y-3 text-[15px] text-brand-offwhite/70 lg:text-right">
            <li>
              <a href={`https://wa.me/${siteConfig.whatsapp}?text=${encodeURIComponent(siteConfig.whatsappMessage)}`} target="_blank" rel="noopener noreferrer" class="hover:text-brand-yellow transition-colors inline-flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                {siteConfig.phone}
              </a>
            </li>
            <li>
              <a href={siteConfig.social.instagram} target="_blank" rel="noopener noreferrer" class="hover:text-brand-yellow transition-colors inline-flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
                @blosseletricidade
              </a>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Copyright -->
    <div class="border-t border-brand-offwhite/10 pt-8 flex flex-col lg:flex-row justify-between items-center gap-4 text-[13px] text-brand-offwhite/40">
      <p>&copy; {year} {siteConfig.name}. Todos os direitos reservados.</p>
      <p>
        <a href={siteConfig.creditUrl} target="_blank" rel="noopener noreferrer" class="hover:text-brand-offwhite transition-colors">
          {siteConfig.credit}
        </a>
      </p>
    </div>
  </div>
</footer>

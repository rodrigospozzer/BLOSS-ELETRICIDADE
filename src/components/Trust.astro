---
import { siteConfig } from '../config/site';
---

<section class="bg-brand-offwhite" aria-label="Informações de Confiança">
  <div class="container mx-auto px-5 lg:px-18">
    <div class="flex flex-col lg:flex-row justify-between lg:items-center py-8 lg:py-16 gap-8 lg:gap-0">
      
      <!-- Avaliação -->
      <div class="flex items-start lg:items-center gap-4 lg:w-1/3" data-reveal>
        <div class="flex-shrink-0 bg-brand-black text-brand-yellow w-16 h-16 rounded-full flex items-center justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
          </svg>
        </div>
        <div>
          <div class="text-[34px] lg:text-[42px] font-extrabold text-brand-black leading-none mb-1">{siteConfig.trust[0].title}</div>
          <div class="text-[14px] lg:text-[16px] text-brand-text-muted leading-snug" set:html={siteConfig.trust[0].desc}></div>
        </div>
      </div>

      <!-- Divider Mobile -->
      <div class="h-px w-full bg-brand-border lg:hidden"></div>
      
      <!-- Divider Desktop -->
      <div class="hidden lg:block w-px h-20 bg-brand-border"></div>

      <!-- Horários -->
      <div class="flex items-start lg:items-center gap-4 lg:w-1/3 lg:justify-center" data-reveal>
        <div class="flex-shrink-0 bg-brand-black text-brand-yellow w-16 h-16 rounded-full flex items-center justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/>
            <polyline points="12 6 12 12 16 14"/>
          </svg>
        </div>
        <div>
          <div class="text-[20px] lg:text-[24px] font-extrabold text-brand-black leading-tight mb-1">{siteConfig.trust[1].title}</div>
          <div class="text-[14px] lg:text-[16px] text-brand-text-muted leading-snug" set:html={siteConfig.trust[1].desc}></div>
        </div>
      </div>

      <!-- Divider Mobile -->
      <div class="h-px w-full bg-brand-border lg:hidden"></div>
      
      <!-- Divider Desktop -->
      <div class="hidden lg:block w-px h-20 bg-brand-border"></div>

      <!-- Localização -->
      <div class="flex items-start lg:items-center gap-4 lg:w-1/3 lg:justify-end" data-reveal>
        <div class="flex-shrink-0 bg-brand-black text-brand-yellow w-16 h-16 rounded-full flex items-center justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
            <circle cx="12" cy="10" r="3"/>
          </svg>
        </div>
        <div>
          <div class="text-[20px] lg:text-[24px] font-extrabold text-brand-black leading-tight mb-1">{siteConfig.trust[2].title}</div>
          <div class="text-[14px] lg:text-[16px] text-brand-text-muted leading-snug" set:html={siteConfig.trust[2].desc}></div>
        </div>
      </div>

    </div>
  </div>
</section>

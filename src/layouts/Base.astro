---
import { siteConfig } from '../config/site';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = siteConfig.name,
  description = siteConfig.description,
  image = new URL('/og-image.jpg', Astro.url).toString(),
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://example.com');

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": siteConfig.name,
  "image": image,
  "@id": canonicalURL.toString(),
  "url": canonicalURL.toString(),
  "telephone": siteConfig.phone,
  "address": {
    "@type": "PostalAddress",
    "streetAddress": siteConfig.address
  },
  "openingHoursSpecification": {
    "@type": "OpeningHoursSpecification",
    "description": siteConfig.hours
  }
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- SEO & Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    
    <!-- Preloads -->
    <link rel="preload" as="image" href="https://images.unsplash.com/photo-1600585154340-be6161a56a0c?q=80&w=2070&auto=format&fit=crop" fetchpriority="high" />
    
    <!-- JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    
    <!-- Motion Base Script -->
    <script is:inline>
      (function() {
        var h = document.documentElement;
        h.classList.add('js');
        setTimeout(function() {
          if (!h.classList.contains('motion-ready')) {
            h.classList.add('reveal-all');
          }
        }, 2500);
      })();
    </script>
  </head>
  <body>
    <a href="#conteudo-principal" class="absolute w-1 h-1 p-0 m-[-1px] overflow-hidden whitespace-nowrap border-0 [clip:rect(0,0,0,0)] focus:w-auto focus:h-auto focus:m-0 focus:whitespace-normal focus:[clip:auto] focus:fixed focus:top-4 focus:left-4 focus:z-[9999] focus:px-4 focus:py-2 focus:bg-brand-black focus:text-brand-yellow focus:font-bold focus:rounded">Ir para o conteúdo</a>
    <Header />
    <main id="conteudo-principal">
      <slot />
    </main>
    <Footer />
    <WhatsAppFloat />
    <script>
      window.addEventListener('load', () => {
        import('../scripts/motion');
      });
    </script>
  </body>
</html>
